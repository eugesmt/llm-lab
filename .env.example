# Copy this file to .env and fill in the keys you have.
# Never commit .env or real API keys to Git.

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Reserved for a future Anthropic provider adapter.
ANTHROPIC_API_KEY=

# Application settings (optional, defaults shown)
# REQUEST_TIMEOUT_S=120
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# RAG_INDEX_DIR=/home/lab-dev/Projects/rag/rag_lab/indexes/structural
# RAG_TOP_K=3
# RAG_INITIAL_TOP_K=8
# RAG_SIMILARITY_THRESHOLD filters enhanced-search candidates before reranking.
# RAG_SIMILARITY_THRESHOLD=0.55
# RAG_CONTEXT_THRESHOLD is the separate minimum score for sufficient answer context.
# Enhanced RAG compares rerank_score; regular RAG compares cosine similarity.
# RAG_CONTEXT_THRESHOLD=0.60
# TASKMANAGER_MCP_URL=http://127.0.0.1:8090/mcp
# MCP_TIMEOUT_S=30
# MCP_MAX_ROUNDS=4
# HOST=127.0.0.1
# PORT=8000
